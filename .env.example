# Mini App abuse-report (server/api/report.post.ts) + submission (server/api/submit-app.post.ts) endpoints

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Local dev test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# GitHub App installed on the target repo. Needs "Issues: write" for the abuse
# report flow, plus "Contents: write" + "Pull requests: write" for the mini app
# submission flow (it opens a PR adding the app).
# Private key is the full PKCS8 PEM (keep the BEGIN/END lines; use \n or a quoted multiline value).
NUXT_GITHUB_APP_ID=
NUXT_GITHUB_APP_PRIVATE_KEY=
NUXT_GITHUB_APP_INSTALLATION_ID=

# Submit login (nuxt-auth-utils). The SAME GitHub App above, using its user-to-server
# OAuth: set the App's Callback URL to <site>/api/auth/github and generate a client
# secret. Login is identity only (the user token is discarded); the App installation
# token above does the repo writes. NUXT_SESSION_PASSWORD seals the identity cookie
# (>= 32 chars, e.g. `openssl rand -base64 32`).
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_SESSION_PASSWORD=

# Abuse-report target repo (defaults to nimiq/awesome). Point at a scratch repo while testing.
NUXT_REPORT_REPO_OWNER=nimiq
NUXT_REPORT_REPO_NAME=awesome

# Mini app submission target repo (defaults to nimiq/awesome). Point at a scratch repo while testing.
NUXT_SUBMIT_REPO_OWNER=nimiq
NUXT_SUBMIT_REPO_NAME=awesome
NUXT_SUBMIT_REPO_BRANCH=main
